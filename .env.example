DATABASE_URL=postgresql://postgres:postgres@localhost:5433/smartearning
DATABASE_SSL_MODE=disable
# Required only with DATABASE_SSL_MODE=verify-full. Use PEM CA material with \n line breaks.
DATABASE_SSL_CA=
# Optional isolated database used by cross-connection advisory-lock integration tests.
PLACEMENT_TEST_DATABASE_URL=
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:3000
# The following values are required only for BSC Testnet registration/package transactions.
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
SMART_EARNING_CHAIN_ID=97
BSC_TESTNET_USDT_ADDRESS=
SMART_EARNING_CONTRACT_ADDRESS=
TREASURY_WALLET=0x66cE23966a5374A5cf42B0FF639C0A909836f371
CONFIRMATIONS_REQUIRED=3
# Live forward-only blockchain indexer. Existing database checkpoints always win.
BLOCKCHAIN_CONFIRMATIONS=3
BLOCKCHAIN_INDEXER_POLL_MS=5000
BLOCKCHAIN_INDEXER_START_MODE=latest
# Optional first-start override; leave empty to checkpoint the current safe block.
BLOCKCHAIN_INDEXER_START_BLOCK=
SMART_EARNING_DEPLOYMENT_BLOCK=121722387
# Live eth_getLogs requests are capped at 200 blocks (default 100).
INDEXER_BLOCK_BATCH_SIZE=100
GENESIS_WALLET=
KEEPER_PRIVATE_KEY=
# The keeper pays BNB gas for automatic placement-cursor advancement.
KEEPER_SECRET=replace-with-at-least-32-random-characters
X3_RECOVERY_ENABLED=true
X3_RECOVERY_INTERVAL_SECONDS=30
X3_RECOVERY_INITIAL_BACKOFF_SECONDS=30
X3_RECOVERY_MAX_BACKOFF_SECONDS=3600
X3_RECOVERY_MAX_AUTOMATIC_ATTEMPTS=10
X3_RECOVERY_BATCH_SIZE=50
DAILY_DIVIDEND_ENABLED=true
DAILY_DIVIDEND_TIMEZONE=Asia/Kolkata
DAILY_DIVIDEND_SETTLEMENT_HOUR=0
DAILY_DIVIDEND_WORKER_INTERVAL_SECONDS=300
AUTO_WITHDRAW_ENABLED=false
WITHDRAWAL_BROADCAST_ENABLED=false
AUTO_WITHDRAW_MINIMUM_UNITS=1000000
AUTO_WITHDRAW_FEE_BPS=1000
AUTO_WITHDRAW_NETWORK=BEP20
AUTO_WITHDRAW_WORKER_INTERVAL_SECONDS=60
AUTO_WITHDRAW_MAX_RETRIES=5
AUTO_WITHDRAW_PRIVATE_KEY=
WITHDRAWAL_AUTHORIZER_ADDRESS=
WITHDRAWAL_AUTHORIZER_URL=
OPERATIONS_HEARTBEAT_INTERVAL_SECONDS=60
# Guarded testnet-only operations smoke test. Never enable for mainnet.
OPERATIONS_TESTNET_SMOKE=false
TESTNET_TEST_PRIVATE_KEY=
ALLOW_TESTNET_WITHDRAWAL_BROADCAST=false
NEXT_PUBLIC_BSC_TESTNET_USDT_ADDRESS=
NEXT_PUBLIC_SMART_EARNING_CONTRACT_ADDRESS=
NEXT_PUBLIC_SMART_EARNING_CHAIN_ID=97
NEXT_PUBLIC_NETWORK_NAME=BNB Smart Chain Testnet
NEXT_PUBLIC_USDT_DECIMALS=6
DEPLOYER_PRIVATE_KEY=
BSCSCAN_API_KEY=
